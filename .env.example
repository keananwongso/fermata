# Frontend: your Convex deployment URL
NEXT_PUBLIC_CONVEX_URL=

# Convex CLI: a deploy key, if you do not log in with `npx convex dev`
CONVEX_DEPLOY_KEY=

# Set on the Convex deployment (npx convex env set), not in the frontend
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Cartesia speech for Ask the books (Convex mints short-lived browser tokens; scripts/export_ask.ts reads it too)
CARTESIA_API_KEY=
# Any long random string. Every public function that writes, starts a run or calls Claude checks it
CONSOLE_KEY=

# Local console only (.env.local), never on the hosted site: the same value as CONSOLE_KEY
NEXT_PUBLIC_FERMATA_CONSOLE_KEY=
